# Adhyaapak configuration template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. Secrets stay on the server; none of these go into the client bundle
# unless prefixed VITE_ (and only non-secret values may be).

# --- Application ---------------------------------------------------------
# Product name shown in the UI and documents. Never hardcode the name in logic.
APP_NAME=Adhyaapak
APP_BASE_URL=http://localhost:5173
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (PostgreSQL) ----------------------------------------------
# Local development uses the Postgres container from docker-compose (added in Phase 1).
DATABASE_URL=postgres://adhyaapak:adhyaapak@localhost:5433/adhyaapak
# Separate database for automated tests; tests must never touch the dev database.
TEST_DATABASE_URL=postgres://adhyaapak:adhyaapak@localhost:5433/adhyaapak_test

# --- Sessions / auth -----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
SESSION_COOKIE_SECURE=false

# --- Mesh API (verified against developers.meshapi.ai, see docs/DECISIONS.md) ---
# OpenAI-compatible gateway. Keys look like rsk_...  Keep server-side only.
MESH_API_BASE_URL=https://api.meshapi.ai/v1
MESH_API_KEY=rsk_replace_me
# Catalog IDs use the form provider/model. Team decision: openai/gpt-4o-mini.
# Confirm `supports_structured_output` and `input_modalities` via GET /v1/models once a key exists.
MESH_API_MODEL=openai/gpt-4o-mini
# Vision-capable model for the paper pipeline (Phase 6). Same model unless the smoke test says otherwise.
MESH_API_VISION_MODEL=openai/gpt-4o-mini
MESH_API_TIMEOUT_MS=30000
MESH_API_MAX_RETRIES=2
# Master switch so the whole app can run with every AI feature off.
AI_ENABLED=true

# --- File storage (private; never served from public URLs) --------------
UPLOAD_STORAGE_MODE=local
UPLOAD_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=10
# Days a photographed answer sheet is kept after approval, then deleted automatically (0 = delete at once)
PAPER_RETENTION_DAYS=30

# --- Optional demo sign-in -------------------------------------------------
# When both are set (and NODE_ENV is not production) the sign-in page shows a "Use demo credentials" button and the
# server creates this teacher on start. These values are PUBLIC by design: use throwaway values, never a real password.
# DEMO_LOGIN_EMAIL=demo.teacher@example.test
# DEMO_LOGIN_PASSWORD=demo-teacher-2026
